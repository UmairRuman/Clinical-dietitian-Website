# ── Supabase (Project Settings -> API Keys) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose to the browser, never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_...

# ── Site ────────────────────────────────────────────────────────────────
# Public address of the website (canonical URLs, sitemap, password-reset links)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Email (Resend). Without a key, emails are skipped with a log line ───
RESEND_API_KEY=
EMAIL_FROM="Dn. Bushra Naseem <hello@your-domain.com>"

# ── Bot protection (Cloudflare Turnstile). Without keys the forms still work (honeypot + rate limit) ─
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Scheduled jobs (random long string; Vercel Cron sends it as a Bearer token) ─
CRON_SECRET=
